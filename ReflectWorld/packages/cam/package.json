    "url": "git+https://github.com/addxai/Cortex.git",
    "directory": "packages/cam"
  },
  "homepage": "https://github.com/addxai/Cortex",
  "engines": {
    "node": ">=22"
  },
  "keywords": ["cortex", "vision", "perception", "ai-agent", "openclaw", "memory"],
  "dependencies": {
    "@cortex/shared": "^0.1.0",
    "@sinclair/typebox": "^0.34.48",
    "jpeg-js": "^0.4.4",
    "pixelmatch": "^7.1.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0"
