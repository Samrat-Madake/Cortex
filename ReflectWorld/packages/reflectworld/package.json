{
  "name": "@cortex/cortex",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortex all-in-one OpenClaw plugin — video capture, perception, memory, automation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bundled-services",
    "bundled-dashboard",
    "skills",
    "openclaw.plugin.json",
    "scripts/post-install.cjs",
    "scripts/models/export_clipreid.py",
    "scripts/models/export_retinaface.py",
    "scripts/models/export_yolo26.py",
    "scripts/models/requirements-export.txt",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addxai/Cortex.git",
    "directory": "packages/cortex"
  },
  "homepage": "https://github.com/addxai/Cortex",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cortex",
    "vision",
    "perception",
    "ai-agent",
    "openclaw",
    "memory"
  ],
  "scripts": {
    "postinstall": "node scripts/post-install.cjs"
  },
  "bin": {
    "cortex": "./dist/src/cli/index.js"
  },
  "dependencies": {
    "@cortex/cam": "^0.1.0",
    "@cortex/mem": "^0.1.0",
    "@cortex/percept": "^0.1.0",
    "@cortex/shared": "^0.1.0",
    "dotenv": "^16.4.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@cortex/cortex",
      "localPath": "extensions/cortex"
    }
  }
}
