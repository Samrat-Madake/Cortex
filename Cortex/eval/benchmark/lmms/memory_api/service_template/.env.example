# Copy this file to `.env` and edit values for your machine.

# Optional Conda activation used by start scripts.
# Leave unset if you already activated an environment before launching.
# CONDA_ENV=lmms-bench
# CONDA_SH=/path/to/conda/etc/profile.d/conda.sh

# Memory bridge service (FastAPI + uvicorn)
HOST=0.0.0.0
PORT=8000
WORKERS=1
MEMORY_SERVICE_DRY_RUN=1
MEMORY_SERVICE_CACHE_MAX_ITEMS=256

# Runtime artifacts
MEMORY_SERVICE_LOG_DIR=$HOME/cortex-benchmark/logs
MEMORY_SERVICE_PID_FILE=$HOME/cortex-benchmark/logs/memory_service.pid
MEMORY_SERVICE_LOG_FILE=$HOME/cortex-benchmark/logs/memory_service.log

# Health check
MEMORY_SERVICE_HEALTH_URL=http://127.0.0.1:8000/healthz
MEMORY_SERVICE_WAIT_SECONDS=30

# If set to 1, your eval wrapper can stop the service after eval.
STOP_SERVICE_ON_EXIT=0
