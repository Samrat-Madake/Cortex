# Cortex standalone configuration — copy to `.env` and fill in your own values.
# Only the VLM_* block is required for Level 0 (VLM-only). Everything else has sane defaults.
# OpenClaw plugin users configure via `npx @cortex/cortex configure` instead of this file.

# ── VLM (required) — OpenAI-compatible or Gemini ──
# VLM_PROVIDER=openai                          # openai | gemini
# VLM_MODEL=gpt-5-mini                         # vision-capable model
# VLM_MODEL_LITE=gpt-5-mini                    # cheaper model for snapshot / single-frame
# VLM_API_KEY=your-vlm-api-key
# VLM_BASE_URL=https://api.openai.com/v1       # OpenAI-compatible endpoint (LiteLLM gateway, etc.)
# LLM_MODEL=gpt-5-mini                         # text compression / narrative
# QA_MODEL=gpt-5-mini                          # Agent-QA / benchmark model; Dashboard chat uses LLM_MODEL

# ── VLM Provider: Google Gemini ──
VLM_PROVIDER=gemini
VLM_API_KEY=AIzaSye...
VLM_MODEL=gemini-1.5-flash
VLM_MODEL_LITE=gemini-1.5-flash
LLM_MODEL=gemini-1.5-flash
QA_MODEL=gemini-1.5-flash

# ── Keep Level 0 (No local ONNX models needed) ──
STUBS_ONLY=true

# ── Infrastructure (defaults) ──
PORT=3210
CORTEX_ENDPOINT=http://127.0.0.1:8219
CORTEX_MEM_PORT=8219
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333



# ── Embedder (optional) — independent OpenAI-compatible embeddings endpoint ──
# EMBEDDER_PROVIDER=openai
# EMBEDDER_MODEL=text-embedding-3-small
# EMBEDDER_API_KEY=
# EMBEDDER_BASE_URL=https://api.openai.com/v1

# ── Infrastructure (defaults usually fine) ──
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
CORTEX_ENDPOINT=http://127.0.0.1:8219
CORTEX_MEM_PORT=8219
PORT=3210                                     # Host / Dashboard

# ── Perception level ──
# STUBS_ONLY=true keeps Level 0 (VLM-only). Set false and run
# `npx @cortex/cortex enable-level1` to enable local detection / ReID.
STUBS_ONLY=true

# ── Speech-to-text (optional) ──
# Leave empty to disable STT. Use `elevenlabs` for cloud transcription with
# speaker diarization, or `moonshine` for local Moonshine Tiny transcription.
# STT_PROVIDER=
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=scribe_v1
# ELEVENLABS_LANGUAGE_CODE=                 # optional, e.g. en; empty means auto-detect
# STT_MODEL_DIR=~/.cortex/models/sherpa-onnx-moonshine-tiny-en-int8
# STT_NUM_THREADS=1
