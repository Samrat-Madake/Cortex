{
  "id": "cortex-cam",
  "name": "Cortex Cam",
  "description": "Video source management — capture, record, extract frames, detect motion via go2rtc gateway",
  "version": "0.1.0",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sources_dir": {
        "type": "string",
        "description": "Directory to persist source configs"
      },
      "recordings_dir": {
        "type": "string",
        "description": "Directory for recorded video segments"
      },
      "go2rtc_api_port": {
        "type": "number",
        "description": "go2rtc HTTP API port (default 1984)"
      },
      "go2rtc_rtsp_port": {
        "type": "number",
        "description": "go2rtc RTSP port (default 8554)"
      }
    }
  }
}
